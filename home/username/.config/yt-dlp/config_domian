# curly braces and shell-quoted strings via "%()q" are already escaped with single quotes!
# shell ("sh") variables must be escaped with double quotes, otherwise they are not expanded before execution!
--ignore-errors
--sponsorblock-remove="all"
--concurrent-fragments="4"
--extract-audio
--audio-format="best"
--audio-quality="0"
--download-archive="/home/ramon/music/yt-dlp/archive_lists/domian_live_2021_fanclub.list"
--no-post-overwrites
--exec='after_move:original_file=%(filepath)q && \
        target_file_no_suffix="${original_file%.*}" && \
        /usr/bin/ffmpeg \
            -hide_banner \
            -i "${original_file}" \
            -n \
            -codec:a aac \
            -b:a 128k \
            -ar:a 44100 \
            -filter:a "volume=1.2,silenceremove=stop_periods=-1:stop_duration=1:stop_threshold=-40dB" \
            "${target_file_no_suffix}.aac"; \
        /bin/rm --force --verbose "${original_file}"'
--output="./%(uploader)s/%(playlist_title|)s/%(title)s [%(id)s][%(format_note)s].%(ext)s"
"https://www.youtube.com/user/danielskate14"
