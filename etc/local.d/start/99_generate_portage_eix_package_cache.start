script_directory_path="${0%/*}"
script_name="${0##*/}"
available_processors=$(/usr/bin/nproc --all)
system_max_load=$(
                    /usr/bin/gawk \
                        --assign="available_processors=${available_processors}" \
                        'BEGIN{ printf "%.2f", available_processors * 0.80 }'
                 )

/usr/bin/logger \
    --tag="generate_portage_eix_package_cache" \
    --id \
    --stderr \
    "${script_directory_path}/${script_name}: executed"

# group commands and fork them to the background
# "stdout" has to be redirected to "/dev/null" separately, since "emerge's" parameter "--quiet" is not reliable.
{
    # update dependency cache first
    /usr/bin/nice \
        --adjustment="19" \
        /usr/bin/ionice \
            --class="3" \
            /usr/bin/emerge \
                --quiet \
                --regen \
                --jobs="${available_processors}" \
                --load-average="${system_max_load}"

    # transfer pre-generated metadata cache to directory "/var/cache/edb/dep/"
    /usr/bin/nice \
        --adjustment="19" \
        /usr/bin/ionice \
            --class="3" \
            /usr/bin/emerge \
                --quiet \
                --metadata

    # generate binary cache from local portage-tree and -overlays
    /usr/bin/nice \
        --adjustment="19" \
        /usr/bin/ionice \
            --class="3" \
            /usr/bin/eix-update \
                --quiet
} >/dev/null &
